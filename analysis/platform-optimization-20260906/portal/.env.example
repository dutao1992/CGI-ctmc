# Copy to /etc/quality-ctmc/quality-portal.env and fill every __REQUIRED__ value.
# Do not commit the filled file.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_API_KEY=__REQUIRED__
ARK_MODEL=doubao-seed-2.0-pro
FAILURE_ANALYSIS_DATA_DIR=/srv/ctmc-quality/data
API_PUBLIC_PREFIX=/failure-analysis-api
IMA_OPENAPI_CLIENTID=__REQUIRED__
IMA_OPENAPI_APIKEY=__REQUIRED__
IMA_KNOWLEDGE_BASE_NAME=__REQUIRED__
PLATFORM_ADMIN_USERNAME=__REQUIRED__
PLATFORM_ADMIN_PASSWORD=__REQUIRED__
PLATFORM_SSO_SECRET=__REQUIRED__
