[Unit]
Description=CTMC Quality Web Portal
After=network-online.target ctmc-quality-api.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /srv/ctmc-quality/current/deploy/web-standalone.conf
ExecStart=/usr/sbin/nginx -c /srv/ctmc-quality/current/deploy/web-standalone.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
